# HealthWatch NG — Supabase configuration
# Copy to .env.local and fill in from your Supabase project's
# Settings → API page. Without these the app runs in local demo mode
# (browser-only auth, empty datasets).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Ingestion pipeline only (`npm run ingest`) — NOT used by the web app.
# SUPABASE_URL may reuse the value above. SUPABASE_SERVICE_ROLE_KEY is the
# service_role secret from Settings → API. It bypasses Row Level Security, so
# it is SERVER-ONLY: never prefix it with NEXT_PUBLIC and never expose it to
# the browser. Leave these blank unless you are running the pipeline.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
